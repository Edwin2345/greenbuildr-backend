meta {
  name: Login
  type: graphql
  seq: 3
}

post {
  url: {{gateway_url}}
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation Login($email: String!, $password: String!) {
    login(email: $email, password: $password)
  }
}

