meta {
  name: Register
  type: graphql
  seq: 1
}

post {
  url: {{auth_url}}
}

body:graphql {
  mutation Register($email: String!, $password: String!) {
    register(email: $email, password: $password)
  }
}

body:graphql:vars {
  {
    "email": "test@example.com",
    "password": "password123"
  }
}
