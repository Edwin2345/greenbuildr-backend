meta {
  name: Register
  type: graphql
  seq: 1
}

post {
  url: {{auth_url}}
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation Register($email: String!, $password: String!) {
    register(email: $email, password: $password)
  }
}

body:graphql:vars {
  {
    "email": "edjoseph226@gmail.com",
    "password": "wind*SWIM*tool*2"
  }
}
