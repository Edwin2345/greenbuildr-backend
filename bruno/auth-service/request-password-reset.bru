meta {
  name: Request Password Reset
  type: graphql
  seq: 4
}

post {
  url: {{gateway_url}}
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation RequestPasswordReset($email: String!) {
    requestPasswordReset(email: $email)
  }
}

