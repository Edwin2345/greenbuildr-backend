meta {
  name: Resend Verification Email
  type: graphql
  seq: 3
}

post {
  url: {{gateway_url}}
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation ResendVerificationEmail($email: String!) {
    resendVerificationEmail(email: $email)
  }
}

body:graphql:vars {
  {
    "email": "edjoseph226@gmail.com"
  }
}
