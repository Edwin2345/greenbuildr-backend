meta {
  name: Reset Password
  type: graphql
  seq: 5
}

post {
  url: {{gateway_url}}
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation ResetPassword($token: String!, $newPassword: String!) {
    resetPassword(token: $token, newPassword: $newPassword)
  }
}

body:graphql:vars {
  {
    "token": "a0173f767252855a25b685fe05b77f281a8fa007c2374364bcfabf1574f4e508",
    "newPassword": "wind*SWIM*tool*1"
  }
}
