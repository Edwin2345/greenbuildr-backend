meta {
  name: Verify Email
  type: graphql
  seq: 2
}

post {
  url: {{auth_url}}
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation VerifyEmail($token: String!) {
    verifyEmail(token: $token)
  }
}

body:graphql:vars {
  {
    "token": "a5d2d7584cc19182ca21b2027840fa0aba3d688ae692c55e5d24c21302be323e"
  }
}
